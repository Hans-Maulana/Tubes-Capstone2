extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Input Label Inventaris
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/administration/inventories") Input Inventaris
                  li.breadcrumb-item.text-muted.active(aria-current="page") Input Label
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error!
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-lg-8
      .card
        .card-body
          h5.card-title.fw-semibold.mb-2 Input Label per Ruangan
          p.card-subtitle.mb-4 Tentukan berapa unit yang masuk ke ruangan yang sama sekaligus. Ulangi langkah ini jika sisa unit masuk ke ruangan berbeda.

          if selectedItem && progress
            .alert.alert-light.border.mb-4
              .d-flex.align-items-center.justify-content-between.flex-wrap.gap-2
                div
                  p.mb-1.text-muted.small Item Pengadaan
                  h6.fw-semibold.mb-0= selectedItem.item_name
                  p.mb-0.text-muted.small= `Tahun ${selectedItem.draft ? selectedItem.draft.year : '-'} • Jenis ${selectedItem.item_type}`
                span.badge.bg-warning.rounded-3.fw-semibold= `${progress.remaining} unit belum berlabel`
              .row.mt-3
                .col-sm-4
                  p.mb-1.text-muted.small Diterima
                  h6.fw-semibold.mb-0= progress.received
                .col-sm-4
                  p.mb-1.text-muted.small Sudah Berlabel
                  h6.fw-semibold.mb-0= progress.labeled
                .col-sm-4
                  p.mb-1.text-muted.small Disetujui Pengadaan
                  h6.fw-semibold.mb-0= progress.approved

            if replacementContext && replacementContext.isReplacement
              .alert.alert-warning.border.mb-4
                .d-flex.align-items-start.gap-2
                  i.ti.ti-replace.fs-5.mt-1
                  div.w-100
                    h6.fw-semibold.mb-2 Item Penggantian Inventaris
                    if replacementContext.replacementReason
                      p.small.mb-2
                        strong Alasan:
                        |  #{replacementContext.replacementReason}
                    if replacementContext.pendingCount > 0
                      p.small.mb-2
                        span.badge.bg-warning.text-dark= `${replacementContext.pendingCount} inventaris lama belum terhubung`
                        span.ms-2.text-muted Label batch ini akan menghubungkan urut dari atas (maks. sesuai jumlah unit yang disimpan).
                    else
                      p.small.mb-2.text-success.mb-0 Semua inventaris lama sudah terhubung ke label baru.
                    if replacementContext.targets && replacementContext.targets.length > 0
                      .table-responsive
                        table.table.table-sm.table-bordered.mb-0
                          thead
                            tr
                              th.small Label Lama
                              th.small Nama
                              th.small Ruangan
                              th.small Kondisi
                              th.small Status Link
                          tbody
                            each target in replacementContext.targets
                              - const inv = target.inventory
                              - const isLinked = inv && replacementContext.pendingTargets && !replacementContext.pendingTargets.some((p) => p.inventory_id === target.inventory_id)
                              tr
                                td.small= inv ? (inv.label_number || '-') : '-'
                                td.small= inv ? inv.name : '-'
                                td.small= inv && inv.room ? inv.room.name : '-'
                                td.small= inv ? inv.condition : '-'
                                td.small
                                  if isLinked
                                    span.badge.bg-success Sudah terhubung
                                  else
                                    span.badge.bg-warning.text-dark Menunggu label

            if roomMismatchWarning
              .alert.alert-danger.border.mb-4
                i.ti.ti-alert-triangle.me-1
                = roomMismatchWarning

            form#inventoryForm(action="/administration/inventories" method="POST")
              input(type="hidden" name="procurement_item_id" value=selectedItem.id)
              .row
                .col-md-6.mb-3
                  label.form-label Kategori Barang
                  select.form-select(name="category_id" required)
                    option(value="" disabled selected=(!formData.category_id)) -- Pilih Kategori --
                    each cat in (categories || [])
                      option(value=cat.id selected=(String(formData.category_id) === String(cat.id)))= cat.name
                  if !categories || categories.length === 0
                    p.small.text-danger.mb-0.mt-1
                      | Belum ada kategori.
                      a(href="/administration/categories/create") Tambah kategori
                .col-md-6.mb-3
                  label.form-label Kondisi
                  select.form-select(name="condition" required)
                    - const selectedCondition = (formData.condition || 'Baik')
                    option(value="Baik" selected=(selectedCondition === 'Baik')) Baik
                    option(value="Maintenance" selected=(selectedCondition === 'Maintenance')) Maintenance
                    option(value="Rusak" selected=(selectedCondition === 'Rusak')) Rusak
                .col-md-6.mb-3
                  label.form-label Ruangan
                  if replacementContext && replacementContext.suggestedRoomId
                    p.small.text-muted.mb-1 Ruangan disarankan dari inventaris lama yang akan diganti.
                  select#room_id.form-select(name="room_id" required)
                    option(value="" disabled selected=(!formData.room_id)) -- Pilih Ruangan --
                    each room in (rooms || [])
                      option(value=room.id selected=(String(formData.room_id) === String(room.id)))= room.name
                  #roomMismatchHint.alert.alert-warning.border-0.py-2.px-3.small.mb-0.mt-2.d-none(role="alert")
                .col-md-6.mb-3
                  label.form-label Jumlah Unit ke Ruangan Ini
                  .input-group
                    input#quantity.form-control(type="number" name="quantity" min="1" max=progress.remaining value=(formData.quantity || 1) required)
                    button#btnAllRemaining.btn.btn-outline-primary(type="button") Semua Sisa
                  p.small.text-muted.mb-0.mt-1 Maksimal #{progress.remaining} unit. Contoh: 6 unit ke Lab Pemrograman, lalu 4 unit ke Lab Jaringan.

              .alert.alert-info.border-0.mb-4
                i.ti.ti-info-circle.me-1
                strong Preview Label:
                span#labelPreview.ms-1= suggestedLabel
                p.small.text-muted.mb-0.mt-1 Format LAB-INV-#{draftYear}-XXX. Nomor urut otomatis per tahun pengadaan.

              .d-flex.gap-2.flex-wrap
                button.btn.btn-primary(type="submit")
                  i.ti.ti-qrcode.me-1
                  | Simpan Label
                a.btn.btn-outline-secondary(href="/administration/inventories") Kembali ke Daftar
          else
            .alert.alert-warning.mb-0
              i.ti.ti-info-circle.me-1
              | Item pengadaan tidak ditemukan. Silakan pilih item dari halaman Input Inventaris.

block scripts
  if selectedItem && progress
    - const pendingRoomHints = (replacementContext && replacementContext.pendingTargets) ? replacementContext.pendingTargets.filter((t) => t.inventory && t.inventory.room_id).map((t) => ({ roomId: t.inventory.room_id, roomName: t.inventory.room ? t.inventory.room.name : '', label: t.inventory.label_number || '-' })) : []
    script.
      document.addEventListener('DOMContentLoaded', function () {
        const quantityInput = document.getElementById('quantity');
        const btnAllRemaining = document.getElementById('btnAllRemaining');
        const labelPreview = document.getElementById('labelPreview');
        const inventoryForm = document.getElementById('inventoryForm');
        const roomSelect = document.getElementById('room_id');
        const roomMismatchHint = document.getElementById('roomMismatchHint');
        const pendingRoomHints = !{JSON.stringify(pendingRoomHints)};
        const maxRemaining = #{progress.remaining};
        const draftYear = #{draftYear};
        const startLabel = '#{suggestedLabel}';

        function getStartSequence() {
          if (!startLabel) return 1;
          const parts = startLabel.split('-');
          const seq = parseInt(parts[parts.length - 1], 10);
          return Number.isNaN(seq) ? 1 : seq;
        }

        function updatePreview() {
          if (!quantityInput || !labelPreview) return;
          const qty = Math.max(1, parseInt(quantityInput.value, 10) || 1);
          const startSeq = getStartSequence();

          if (qty === 1) {
            labelPreview.textContent = `LAB-INV-${draftYear}-${String(startSeq).padStart(3, '0')}`;
            return;
          }

          const endSeq = startSeq + qty - 1;
          labelPreview.textContent = `LAB-INV-${draftYear}-${String(startSeq).padStart(3, '0')} s/d LAB-INV-${draftYear}-${String(endSeq).padStart(3, '0')} (${qty} label)`;
        }

        if (btnAllRemaining && quantityInput) {
          btnAllRemaining.addEventListener('click', function () {
            quantityInput.value = maxRemaining;
            updatePreview();
            updateRoomMismatchHint();
          });
        }

        if (quantityInput) {
          updatePreview();
        }

        function updateRoomMismatchHint() {
          if (!roomSelect || !roomMismatchHint || pendingRoomHints.length === 0) return;
          const selectedRoomId = parseInt(roomSelect.value, 10);
          const qty = Math.max(1, parseInt(quantityInput ? quantityInput.value : '1', 10) || 1);
          const toCheck = pendingRoomHints.slice(0, qty);
          const mismatched = toCheck.filter((h) => h.roomId && h.roomId !== selectedRoomId);
          if (mismatched.length === 0) {
            roomMismatchHint.classList.add('d-none');
            roomMismatchHint.textContent = '';
            return;
          }
          const labels = mismatched.map((h) => `${h.label} (${h.roomName})`).join(', ');
          roomMismatchHint.textContent = `Perhatian: ruangan berbeda dari inventaris lama ${labels}.`;
          roomMismatchHint.classList.remove('d-none');
        }

        if (roomSelect) {
          roomSelect.addEventListener('change', updateRoomMismatchHint);
        }
        if (quantityInput) {
          quantityInput.addEventListener('input', function () {
            updatePreview();
            updateRoomMismatchHint();
          });
        }
        updateRoomMismatchHint();

        if (inventoryForm && quantityInput) {
          inventoryForm.addEventListener('submit', async function (e) {
            if (inventoryForm.dataset.uiInventorySubmitting === '1') return;

            const qty = parseInt(quantityInput.value, 10) || 1;
            const roomName = roomSelect && roomSelect.selectedIndex > 0
              ? roomSelect.options[roomSelect.selectedIndex].text
              : 'ruangan terpilih';

            let message = qty === 1
              ? `Simpan 1 label ke ${roomName}?`
              : `Simpan ${qty} label sekaligus ke ${roomName}?`;

            if (pendingRoomHints.length > 0) {
              const selectedRoomId = roomSelect ? parseInt(roomSelect.value, 10) : null;
              const mismatched = pendingRoomHints.slice(0, qty).filter((h) => h.roomId && h.roomId !== selectedRoomId);
              if (mismatched.length > 0) {
                message += '\n\nRuangan berbeda dari inventaris lama. Lanjutkan?';
              }
            }

            e.preventDefault();
            e.stopImmediatePropagation();

            const confirmed = window.uiConfirm
              ? await window.uiConfirm(message, { title: 'Konfirmasi Label Inventaris', confirmText: 'Simpan Label' })
              : true;

            if (!confirmed) return;

            inventoryForm.dataset.uiInventorySubmitting = '1';
            HTMLFormElement.prototype.submit.call(inventoryForm);
          });
        }
      });
