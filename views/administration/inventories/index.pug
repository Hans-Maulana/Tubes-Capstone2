extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Input Inventaris
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item.text-muted.active(aria-current="page") Input Inventaris
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if success
    .alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa.fa-check-circle.me-2
      strong Sukses! 
      = success
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error! 
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .card.w-100.mb-4
    .card-body
      h5.card-title.fw-semibold.mb-1 Item Menunggu Label
      p.card-subtitle.mb-4 Hanya barang yang sudah dicatat di Penerimaan Barang yang bisa diberi label. Input per batch ruangan: tentukan berapa unit masuk ke ruangan yang sama sekaligus.

      .table-responsive
        table.table.align-middle.text-nowrap.mb-0
          thead.text-dark.fs-4
            tr
              th.border-bottom-0.fw-semibold No
              th.border-bottom-0.fw-semibold Nama Barang
              th.border-bottom-0.fw-semibold Jenis
              th.border-bottom-0.fw-semibold Tahun
              th.border-bottom-0.fw-semibold Progress Label
              th.border-bottom-0.fw-semibold.text-center Aksi
          tbody
            if pendingItems && pendingItems.length > 0
              each entry, index in pendingItems
                tr
                  td.border-bottom-0= index + 1
                  td.border-bottom-0
                    h6.fw-semibold.mb-0= entry.item.item_name
                  td.border-bottom-0
                    if entry.isReplacement
                      span.badge.bg-light-warning.text-warning.fw-semibold
                        i.ti.ti-replace.me-1
                        | Penggantian
                      if entry.pendingReplacementCount > 0
                        small.text-muted.d-block= `${entry.pendingReplacementCount} belum terhubung`
                    else
                      span.text-muted Baru
                  td.border-bottom-0= entry.item.draft ? entry.item.draft.year : '-'
                  td.border-bottom-0
                    span= `${entry.labeled} / ${entry.received} berlabel`
                    small.text-muted.d-block Disetujui: #{entry.approved}
                    span.badge.bg-warning.rounded-3.fw-semibold.mt-1= `Sisa ${entry.remaining}`
                  td.border-bottom-0.text-center
                    a.btn.btn-sm.btn-primary(href=`/administration/inventories/create?item=${entry.item.id}`)
                      i.ti.ti-qrcode.me-1
                      | Input Label
            else
              tr
                td.text-center.py-4(colspan="6")
                  if hasAnyReceipt
                    | Semua unit yang sudah diterima sudah memiliki label.
                  else
                    | Belum ada penerimaan barang inventaris.
                    br
                    small.text-muted Lakukan penerimaan terlebih dahulu di menu Penerimaan Barang.

  .card.w-100
    .card-body
      h5.card-title.fw-semibold.mb-1 Daftar Inventaris Berlabel
      p.card-subtitle.mb-4 Satu baris = satu unit barang = satu nomor label = satu QR code.

      //- Filter Form
      form(method="GET" action="/administration/inventories" class="row g-3 mb-4 align-items-end border p-3 rounded bg-light")
        .col-md-3
          label.form-label.fw-semibold Cari Nama Barang
          input.form-control(type="text" name="q" value=selectedQ placeholder="Contoh: Kursi, Monitor...")
        .col-md-3
          label.form-label.fw-semibold Nomor Label
          input.form-control(type="text" name="label" value=selectedLabel placeholder="Contoh: LAB-INV-2026-001")
        .col-md-2
          label.form-label.fw-semibold Ruangan
          select.form-select(name="room_id")
            option(value="") -- Semua Ruangan --
            each room in (rooms || [])
              option(value=room.id selected=(String(selectedRoomId) === String(room.id)))= room.name
        .col-md-2
          label.form-label.fw-semibold Kategori
          select.form-select(name="category_id")
            option(value="") -- Semua Kategori --
            each cat in (categories || [])
              option(value=cat.id selected=(String(selectedCategoryId) === String(cat.id)))= cat.name
        .col-md-2
          label.form-label.fw-semibold Tahun
          select.form-select(name="year")
            option(value="") -- Semua Tahun --
            each y in (years || [])
              option(value=y selected=(String(selectedYear) === String(y)))= y
        .col-12.d-flex.gap-2.justify-content-end
          button.btn.btn-primary(type="submit")
            i.ti.ti-search.me-1
            | Cari
          a.btn.btn-outline-secondary(href="/administration/inventories")
            i.ti.ti-refresh.me-1
            | Reset

      if selectedLabel || selectedQ
        .alert.alert-info.py-2.mb-3
          i.ti.ti-filter.me-1
          | Menampilkan hasil filter
          if selectedQ
            |  nama barang mengandung "#{selectedQ}"
          if selectedLabel
            |  nomor label mengandung "#{selectedLabel}"

      .table-responsive.mt-2
        table.table.align-middle.text-nowrap.mb-0
          thead.text-dark.fs-4
            tr
              th.border-bottom-0.fw-semibold No
              th.border-bottom-0.fw-semibold Nomor Label
              th.border-bottom-0.fw-semibold Nama Barang
              th.border-bottom-0.fw-semibold Kategori
              th.border-bottom-0.fw-semibold Tahun
              th.border-bottom-0.fw-semibold Ruangan
              th.border-bottom-0.fw-semibold QR
              th.border-bottom-0.fw-semibold.text-center Aksi
          tbody
            if inventories && inventories.length > 0
              each inv, index in inventories
                tr
                  td.border-bottom-0= index + 1
                  td.border-bottom-0
                    h6.fw-semibold.mb-0= inv.label_number || '-'
                  td.border-bottom-0= inv.name || (inv.procurementItem ? inv.procurementItem.item_name : '-')
                  td.border-bottom-0
                    span.badge.bg-light-primary.text-primary.fw-semibold= inv.itemCategory ? inv.itemCategory.name : (inv.category || '-')
                  td.border-bottom-0= inv.procurementItem && inv.procurementItem.draft ? inv.procurementItem.draft.year : '-'
                  td.border-bottom-0
                    span.badge.bg-light-secondary.text-secondary.fw-semibold= inv.room ? inv.room.name : '-'
                  td.border-bottom-0
                    if inv.qr_image_path
                      img.rounded.border(src=inv.qr_image_path alt=`QR ${inv.label_number}` style="width: 48px; height: 48px; object-fit: cover;")
                      a.small.d-block.mt-1(href=`/inventory-label/${encodeURIComponent(inv.label_number)}` target="_blank") Detail
                    else
                      span.text-muted -
                  td.border-bottom-0.text-center
                    .d-flex.justify-content-center.gap-1
                      a.btn.btn-sm.btn-outline-primary(href=`/administration/inventories/${inv.id}/edit`)
                        i.ti.ti-edit
                      form(action=`/administration/inventories/${inv.id}/delete` method="POST" data-confirm-message="Hapus inventaris ini?")
                        button.btn.btn-sm.btn-outline-danger(type="submit")
                          i.ti.ti-trash
            else
              tr
                td.text-center.py-4(colspan="8") Belum ada inventaris berlabel.
