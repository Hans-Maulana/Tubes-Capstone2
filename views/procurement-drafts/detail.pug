extends ../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8= `Draf Pengadaan ${draft.year}`
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/procurement-drafts") Draf Pengadaan
                  li.breadcrumb-item.text-muted.active(aria-current="page") Detail
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if success
    .alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa.fa-check-circle.me-2
      strong Sukses! 
      = success
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error! 
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if warning
    .alert.alert-warning.alert-dismissible.fade.show(role="alert")
      i.ti.ti-alert-triangle.me-2
      strong Peringatan!
      = warning
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  if draft.status === 'Submitted'
    .alert.alert-info.alert-dismissible.fade.show(role="alert")
      i.ti.ti-info-circle.me-2
      strong Info! 
      | Draf telah diajukan. Anda masih dapat mengedit draf sampai melakukan pengajuan finalisasi. Item sedang menunggu review dari Ketua Program Studi.
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-lg-4
      .card
        .card-body
          h5.card-title.fw-semibold.mb-3 Ringkasan Draf
          .mb-3
            p.mb-1.text-muted Tahun
            h6.fw-semibold.mb-0= draft.year
          .mb-3
            p.mb-1.text-muted Status
            if draft.status === 'Locked'
              span.badge.bg-dark.rounded-3.fw-semibold Locked
            else if draft.status === 'Submitted'
              span.badge.bg-info.rounded-3.fw-semibold Submitted
            else if draft.status === 'Approved'
              span.badge.bg-success.rounded-3.fw-semibold Disetujui
            else if draft.status === 'Rejected'
              span.badge.bg-danger.rounded-3.fw-semibold Ditolak
            else
              span.badge.bg-warning.rounded-3.fw-semibold= draft.status
          .mb-3
            p.mb-1.text-muted Jumlah Item
            h6.fw-semibold.mb-0= draft.items ? draft.items.length : 0
          if locked
            .alert.alert-secondary.mb-0
              i.ti.ti-lock.me-1
              | Draf terkunci dan tidak dapat diubah.
          else
            .d-flex.flex-column.gap-2
              if draft.status === 'Submitted'
                form(action=`/procurement-drafts/${draft.id}/lock` method="POST" onsubmit="return confirm('Apakah Anda yakin ingin mengajukan finalisasi draf ini? Setelah diajukan, draf tidak dapat diubah lagi.')")
                  button.btn.btn-dark.w-100(type="submit")
                    i.ti.ti-lock.me-1
                    | Pengajuan Finalisasi
              else
                form(action=`/procurement-drafts/${draft.id}/submit` method="POST")
                  button.btn.btn-outline-primary.w-100(type="submit")
                    i.ti.ti-send.me-1
                    | Ajukan Draf
    .col-lg-8
      .card
        .card-body
          .d-flex.justify-content-between.align-items-center.mb-4
            h5.card-title.fw-semibold.mb-0 Daftar Item Pengadaan
            if !locked
              button.btn.btn-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#addItemModal")
                i.ti.ti-plus.me-1
                | Tambah Item

          .table-responsive
            table.table.align-middle.text-nowrap.mb-0
              thead.text-dark.fs-4
                tr
                  th.border-bottom-0.fw-semibold No
                  th.border-bottom-0.fw-semibold Jenis
                  th.border-bottom-0.fw-semibold Nama Barang
                  th.border-bottom-0.fw-semibold Jumlah
                  th.border-bottom-0.fw-semibold Satuan
                  th.border-bottom-0.fw-semibold Harga
                  th.border-bottom-0.fw-semibold Link
                  th.border-bottom-0.fw-semibold Pengganti
                  if draft.status !== 'Draft'
                    th.border-bottom-0.fw-semibold Status Item
                  if !locked
                    th.border-bottom-0.fw-semibold.text-center Aksi
              tbody
                if draft.items && draft.items.length > 0
                  each item, index in draft.items
                    tr
                      td.border-bottom-0= index + 1
                      td.border-bottom-0
                        span.badge.bg-light-primary.text-primary.fw-semibold= item.item_type || '-'
                      td.border-bottom-0
                        h6.fw-semibold.mb-0= item.item_name || '-'
                      td.border-bottom-0= item.quantity || 0
                      td.border-bottom-0
                        if item.item_type === 'BHP'
                          span.badge.bg-light-secondary.text-secondary.fw-semibold= item.unit || 'pcs'
                        else
                          span.text-muted -
                      td.border-bottom-0= `Rp ${Number(item.price || 0).toLocaleString('id-ID')}`
                      td.border-bottom-0
                        if item.purchase_link
                          a.btn.btn-sm.btn-outline-primary(href=item.purchase_link target="_blank" rel="noopener noreferrer")
                            i.ti.ti-external-link
                        else
                          span.text-muted -
                      td.border-bottom-0
                        if item.replacementTargets && item.replacementTargets.length > 0
                          each target, tIdx in item.replacementTargets
                            if tIdx > 0
                              br
                            span.text-wrap.d-inline-block(style="max-width: 220px;")= target.inventory ? `${target.inventory.label_number} - ${target.inventory.name}` : '-'
                          if item.replacement_reason
                            small.text-muted.d-block= `Alasan: ${item.replacement_reason}`
                        else if item.replacementInventory
                          span.text-wrap.d-inline-block(style="max-width: 220px;")= `${item.replacementInventory.label_number || '-'} - ${item.replacementInventory.name}`
                        else
                          span.text-muted -
                      if draft.status !== 'Draft'
                        td.border-bottom-0
                          if item.status === 'Approved'
                            span.badge.bg-light-success.text-success.fw-semibold
                              i.ti.ti-circle-check.me-1
                              | Disetujui
                          else if item.status === 'Rejected'
                            span.badge.bg-light-danger.text-danger.fw-semibold
                              i.ti.ti-circle-x.me-1
                              | Ditolak
                          else
                            span.badge.bg-light-warning.text-warning.fw-semibold
                              i.ti.ti-help.me-1
                              | Menunggu Review
                      if !locked
                        td.border-bottom-0.text-center
                          .d-flex.justify-content-center.gap-2
                            a.btn.btn-sm.btn-outline-warning(href=`/procurement-drafts/${draft.id}/items/${item.id}/edit`)
                              i.ti.ti-edit
                            form(action=`/procurement-drafts/${draft.id}/items/${item.id}/delete` method="POST" onsubmit="return confirm('Hapus item ini dari draf?')")
                              button.btn.btn-sm.btn-outline-danger(type="submit")
                                i.ti.ti-trash
                else
                  tr
                    td.text-center.py-4(colspan=(draft.status !== 'Draft' ? (locked ? 9 : 10) : (locked ? 8 : 9))) Belum ada item pengadaan.

  if !locked
    // Add Item Modal
    #addItemModal.modal.fade(tabindex="-1" aria-labelledby="addItemModalLabel" aria-hidden="true")
      .modal-dialog.modal-lg.modal-dialog-centered
        .modal-content
          .modal-header
            h5#addItemModalLabel.modal-title.fw-semibold Tambah Item Pengadaan
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          form#addItemForm(action=`/procurement-drafts/${draft.id}/items` method="POST" data-ajax-item-form="1")
            .modal-body
              #addItemFormError.alert.alert-danger.d-none(role="alert")
                i.ti.ti-alert-circle.me-1
                strong Error!
                span#addItemFormErrorText
              .row
                .col-md-6.mb-3
                  label.form-label(for="item_type") Jenis Barang
                  select#item_type.form-select(name="item_type" required)
                    option(value="" disabled selected) -- Pilih Jenis --
                    option(value="Inventaris") Inventaris
                    option(value="BHP") Barang Habis Pakai
                .col-md-6.mb-3
                  label.form-label(for="item_name") Nama Barang
                  input#item_name.form-control(type="text" name="item_name" placeholder="Contoh: Oscilloscope / Kabel jumper" required)
                .col-md-6.mb-3
                  label.form-label(for="quantity") Jumlah
                  input#quantity.form-control(type="number" name="quantity" min="1" required)
                .col-md-6.mb-3#bhp_unit_field(style="display: none;")
                  label.form-label(for="unit") Satuan BHP
                  input#unit.form-control(type="text" name="unit" value="pcs" placeholder="Contoh: pcs, botol, roll")
                  p.small.text-muted.mb-0 Default: pcs
                .col-md-6.mb-3
                  label.form-label(for="price") Harga Satuan
                  input#price.form-control(type="number" name="price" min="0" required)
                .col-12.mb-3
                  label.form-label(for="purchase_link") Link Pembelian
                  input#purchase_link.form-control(type="url" name="purchase_link" placeholder="https://...")
                .col-12.mb-3#replacement_section(style="display: none;")
                  label.form-label Pengganti Inventaris Rusak / Maintenance
                  include ../partials/replacement-inventory-picker
                  label.form-label.mt-3(for="replacement_reason") Alasan Penggantian
                  textarea#replacement_reason.form-control(name="replacement_reason" rows="3" placeholder="Jelaskan mengapa barang lama perlu diganti...")
            .modal-footer
              button.btn.btn-outline-secondary(type="button" data-bs-dismiss="modal") Batal
              button#addItemSubmitBtn.btn.btn-primary(type="submit")
                i.ti.ti-plus.me-1
                | Tambah Item

block scripts
  script(src="/js/replacement-inventory-picker.js")
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const itemTypeSelect = document.getElementById('item_type');
      const unitField = document.getElementById('bhp_unit_field');
      const unitInput = document.getElementById('unit');
      const replacementSection = document.getElementById('replacement_section');
      const addItemModal = document.getElementById('addItemModal');
      const addItemForm = document.getElementById('addItemForm');
      const addItemFormError = document.getElementById('addItemFormError');
      const addItemFormErrorText = document.getElementById('addItemFormErrorText');
      const addItemSubmitBtn = document.getElementById('addItemSubmitBtn');

      function hideAddItemFormError() {
        if (addItemFormError) addItemFormError.classList.add('d-none');
        if (addItemFormErrorText) addItemFormErrorText.textContent = '';
      }

      function showAddItemFormError(message) {
        if (!addItemFormError || !addItemFormErrorText) return;
        addItemFormErrorText.textContent = message;
        addItemFormError.classList.remove('d-none');
        addItemFormError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      function toggleUnitField() {
        const isBhp = itemTypeSelect && itemTypeSelect.value === 'BHP';
        if (unitField) {
          unitField.style.display = isBhp ? '' : 'none';
        }
        if (unitInput) {
          unitInput.required = isBhp;
          if (isBhp && !unitInput.value.trim()) {
            unitInput.value = 'pcs';
          }
        }
        if (replacementSection) {
          replacementSection.style.display = isBhp ? 'none' : '';
        }
        if (window.setReplacementPickerEnabled) {
          window.setReplacementPickerEnabled(!isBhp, replacementSection);
        }
      }

      if (itemTypeSelect) {
        itemTypeSelect.addEventListener('change', toggleUnitField);
        toggleUnitField();
      }

      if (addItemModal) {
        addItemModal.addEventListener('shown.bs.modal', function () {
          hideAddItemFormError();
          if (window.initReplacementInventoryPickers) {
            window.initReplacementInventoryPickers(replacementSection, document.getElementById('replacement_reason'));
          }
          toggleUnitField();
        });
        addItemModal.addEventListener('hidden.bs.modal', function () {
          hideAddItemFormError();
          if (addItemForm) addItemForm.reset();
          const pickerRoot = replacementSection && replacementSection.querySelector('[data-picker-root]');
          if (pickerRoot && pickerRoot._replacementPickerUpdate) {
            pickerRoot._replacementPickerUpdate();
          }
          if (window.setReplacementPickerEnabled) {
            window.setReplacementPickerEnabled(false, replacementSection);
          }
          toggleUnitField();
        });
      }

      function buildUrlEncodedBody(form) {
        const params = new URLSearchParams();
        form.querySelectorAll('input, select, textarea').forEach(function (el) {
          if (!el.name || el.disabled) return;
          if (el.type === 'checkbox') {
            if (el.checked) params.append(el.name, el.value);
            return;
          }
          if (el.type === 'radio') {
            if (el.checked) params.append(el.name, el.value);
            return;
          }
          params.append(el.name, el.value);
        });
        return params;
      }

      async function parseAjaxResponse(response) {
        const text = await response.text();
        if (!text) {
          return { ok: false, error: `Server mengembalikan respons kosong (HTTP ${response.status}).` };
        }
        try {
          return JSON.parse(text);
        } catch (parseErr) {
          if (response.redirected || (text.includes('<!DOCTYPE') || text.includes('<html'))) {
            return {
              ok: false,
              error: 'Sesi berakhir atau server mengembalikan halaman HTML. Refresh halaman lalu login ulang jika perlu.'
            };
          }
          return { ok: false, error: text.slice(0, 200) };
        }
      }

      if (addItemForm) {
        addItemForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          hideAddItemFormError();

          if (!addItemForm.checkValidity()) {
            addItemForm.reportValidity();
            return;
          }

          const pickerRoot = replacementSection && replacementSection.querySelector('[data-picker-root]');
          if (pickerRoot && window.getReplacementCategoryMismatch) {
            const categoryMsg = window.getReplacementCategoryMismatch(pickerRoot);
            if (categoryMsg && !window.confirm(`${categoryMsg}\n\nLanjutkan menyimpan?`)) {
              return;
            }
          }

          const originalBtnHtml = addItemSubmitBtn ? addItemSubmitBtn.innerHTML : '';
          if (addItemSubmitBtn) {
            addItemSubmitBtn.disabled = true;
            addItemSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Menyimpan...';
          }

          try {
            const response = await fetch(addItemForm.action, {
              method: 'POST',
              redirect: 'manual',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                Accept: 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
              },
              body: buildUrlEncodedBody(addItemForm).toString()
            });

            if (response.status >= 300 && response.status < 400) {
              showAddItemFormError('Permintaan dialihkan oleh server. Refresh halaman lalu coba lagi.');
              return;
            }

            const data = await parseAjaxResponse(response);

            if (!response.ok || !data.ok) {
              showAddItemFormError(
                data.error
                || data.message
                || `Gagal menambahkan item (HTTP ${response.status}).`
              );
              return;
            }

            let target = data.redirect || window.location.pathname;
            if (data.warning) {
              target += (target.includes('?') ? '&' : '?') + 'warning=' + encodeURIComponent(data.warning);
            }
            if (data.success) {
              target += (target.includes('?') ? '&' : '?') + 'flash=' + encodeURIComponent(data.success);
            }
            window.location.href = target;
          } catch (err) {
            showAddItemFormError(err.message || 'Terjadi kesalahan jaringan. Coba lagi.');
          } finally {
            if (addItemSubmitBtn) {
              addItemSubmitBtn.disabled = false;
              addItemSubmitBtn.innerHTML = originalBtnHtml;
            }
          }
        });
      }
    });

