extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Kelola Inventaris
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item.text-muted.active(aria-current="page") Kelola Inventaris
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if success
    .alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa.fa-check-circle.me-2
      strong Sukses!
      = success
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error!
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-12
      .card.w-100
        .card-body
          .d-flex.align-items-center.justify-content-between.mb-4.flex-wrap.gap-2
            div
              h5.card-title.fw-semibold.mb-0 Inventaris Laboratorium
              p.card-subtitle.mb-0 Mulai maintenance, ubah status, atau pindah ruangan. Scan QR untuk menampilkan 1 barang.
            .d-flex.gap-2.flex-wrap
              a.btn.btn-outline-primary.d-flex.align-items-center.gap-2(href="/stafflab/inventories/scan")
                i.ti.ti-scan.fs-5
                | Scan QR
              a.btn.btn-outline-secondary.d-flex.align-items-center.gap-2(href="/stafflab/maintenance")
                i.ti.ti-history.fs-5
                | Log Maintenance

          form(method="GET" action="/stafflab/inventories" class="row g-3 mb-4 align-items-end border p-3 rounded bg-light")
            .col-md-3
              label.form-label.fw-semibold Cari Nama Barang
              input.form-control(type="text" name="q" value=selectedQ placeholder="Contoh: Kursi, Monitor...")
            .col-md-3
              label.form-label.fw-semibold Nomor Label
              input.form-control(type="text" name="label" value=selectedLabel placeholder="Contoh: LAB-INV-2026-001")
            .col-md-2
              label.form-label.fw-semibold Ruangan
              select.form-select(name="room_id")
                option(value="") -- Semua --
                each room in (rooms || [])
                  option(value=room.id selected=(String(selectedRoomId) === String(room.id)))= room.name
            .col-md-2
              label.form-label.fw-semibold Kategori
              select.form-select(name="category_id")
                option(value="") -- Semua --
                each cat in (categories || [])
                  option(value=cat.id selected=(String(selectedCategoryId) === String(cat.id)))= cat.name
            .col-md-2.d-flex.gap-2
              button.btn.btn-primary.w-100(type="submit")
                i.ti.ti-search.me-1
                | Cari
              a.btn.btn-outline-secondary.w-100(href="/stafflab/inventories" title="Reset")
                i.ti.ti-refresh

          if selectedLabel || selectedQ
            .alert.alert-info.py-2.mb-3
              i.ti.ti-filter.me-1
              | Menampilkan hasil filter
              if selectedLabel
                |  nomor label mengandung "#{selectedLabel}"
              if selectedQ
                |  nama barang mengandung "#{selectedQ}"

          .table-responsive.mt-4
            table.table.table-hover.align-middle.mb-0
              thead.table-light
                tr
                  th.fw-semibold No
                  th.fw-semibold Nomor Label
                  th.fw-semibold Nama Barang
                  th.fw-semibold Kategori
                  th.fw-semibold Ruangan
                  th.fw-semibold Kondisi
                  th.fw-semibold.text-center Aksi
              tbody
                if inventories && inventories.length > 0
                  each inv, index in inventories
                    tr
                      td= index + 1
                      td
                        h6.fw-semibold.mb-0= inv.label_number || '-'
                      td= inv.name || (inv.procurementItem ? inv.procurementItem.item_name : '-')
                      td
                        span.badge.bg-light-primary.text-primary= inv.itemCategory ? inv.itemCategory.name : (inv.category || '-')
                      td
                        span.badge.bg-light-secondary.text-secondary= inv.room ? inv.room.name : '-'
                      td
                        if inv.condition === 'Baik'
                          span.badge.bg-success.rounded-3.fw-semibold Baik
                        else if inv.condition === 'Maintenance'
                          span.badge.bg-warning.rounded-3.fw-semibold Maintenance
                        else
                          span.badge.bg-danger.rounded-3.fw-semibold Rusak
                      td.text-center
                        .d-flex.justify-content-center.gap-1.flex-nowrap
                          a.btn.btn-sm.btn-outline-secondary(href=`/stafflab/inventories/${inv.id}/change-status` title="Ubah Status")
                            i.ti.ti-refresh
                            span.d-none.d-md-inline.ms-1 Status
                          if inv.condition === 'Maintenance'
                            a.btn.btn-sm.btn-success(href=`/stafflab/inventories/${inv.id}/complete-maintenance` title="Selesaikan Maintenance")
                              i.ti.ti-circle-check
                              span.d-none.d-md-inline.ms-1 Selesai
                          else
                            form(action=`/stafflab/inventories/${inv.id}/start-maintenance` method="POST" data-confirm-message="Tandai barang ini sedang maintenance?")
                              button.btn.btn-sm.btn-warning(type="submit" title="Mulai Maintenance")
                                i.ti.ti-tool
                                span.d-none.d-md-inline.ms-1 Maint.
                          a.btn.btn-sm.btn-outline-primary(href=`/stafflab/inventories/${inv.id}/move-room` title="Pindah Ruangan")
                            i.ti.ti-door
                            span.d-none.d-md-inline.ms-1 Ruang
                else
                  tr
                    td.text-center.py-4(colspan="7") Belum ada data inventaris yang sesuai dengan filter.
