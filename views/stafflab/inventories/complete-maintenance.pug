extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Selesaikan Maintenance
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/stafflab/inventories") Kelola Inventaris
                  li.breadcrumb-item.text-muted.active(aria-current="page") Selesaikan Maintenance
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error!
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-lg-8
      .card
        .card-body
          h5.card-title.fw-semibold.mb-3 Form Selesai Maintenance
          p.card-subtitle.mb-4 Isi detail perbaikan. Data akan disimpan ke log maintenance setelah disimpan.

          .alert.alert-warning.border-0.mb-4
            i.ti.ti-tool.me-1
            strong= inventory.label_number
            |  — #{inventory.name}
            span.badge.bg-warning.ms-2 Sedang Maintenance

          form(action=`/stafflab/inventories/${inventory.id}/complete-maintenance` method="POST" data-confirm-message="Simpan log maintenance dan ubah kondisi inventaris?")
            .row
              .col-md-6.mb-3
                label.form-label Kondisi Setelah Maintenance
                select.form-select(name="condition" required)
                  each cond in (conditions || [])
                    option(value=cond selected=(formData.condition === cond))= cond
              .col-md-6.mb-3
                label.form-label Tanggal Selesai
                input.form-control(type="date" name="date" value=formData.date required)
            .mb-3
              label.form-label Deskripsi / Tindakan Maintenance
              textarea.form-control(name="description" rows="4" placeholder="Jelaskan perbaikan yang dilakukan..." required)= formData.description || ''

            hr.my-4
            .d-flex.align-items-center.justify-content-between.mb-3
              h6.fw-semibold.mb-0 Penggunaan BHP (Opsional)
              button#add-bhp-row.btn.btn-outline-primary.btn-sm.d-flex.align-items-center.gap-1(type="button")
                i.ti.ti-plus
                | Tambah BHP

            #bhp-rows-container.mb-3(data-bhps=JSON.stringify(bhps))
              if formData.bhpsUsed && formData.bhpsUsed.length > 0
                each selectedBhp, idx in formData.bhpsUsed
                  .row.bhp-row.mb-3
                    .col-md-5
                      label.form-label Pilih BHP
                      select.form-select.bhp-select(name="bhp_ids[]")
                        option(value="") -- Pilih BHP --
                        each bhp in (bhps || [])
                          option(value=bhp.id selected=(String(selectedBhp.bhp_id) === String(bhp.id)) data-stock=bhp.stock data-unit=bhp.unit)
                            = `${bhp.name} (Tersedia: ${bhp.stock} ${bhp.unit})`
                      small.bhp-stock-help.text-primary.fw-semibold.mt-1.d-block
                    .col-md-5
                      label.form-label Jumlah BHP Digunakan
                      input.form-control.bhp-qty(type="number" name="bhp_quantities[]" min="1" max=selectedBhp.maxStock value=selectedBhp.quantity placeholder="Jumlah")
                    .col-md-2
                      label.form-label.d-none.d-md-block &nbsp;
                      button.btn.btn-outline-danger.remove-bhp-row.w-100(type="button" style=`display: ${formData.bhpsUsed.length > 1 ? 'block' : 'none'}; height: 38px;`)
                        i.ti.ti-trash
              else
                .row.bhp-row.mb-3
                  .col-md-5
                    label.form-label Pilih BHP
                    select.form-select.bhp-select(name="bhp_ids[]")
                      option(value="") -- Pilih BHP --
                      each bhp in (bhps || [])
                        option(value=bhp.id data-stock=bhp.stock data-unit=bhp.unit)
                          = `${bhp.name} (Tersedia: ${bhp.stock} ${bhp.unit})`
                    small.bhp-stock-help.text-primary.fw-semibold.mt-1.d-block
                  .col-md-5
                    label.form-label Jumlah BHP Digunakan
                    input.form-control.bhp-qty(type="number" name="bhp_quantities[]" min="1" placeholder="Jumlah" disabled)
                  .col-md-2
                    label.form-label.d-none.d-md-block &nbsp;
                    button.btn.btn-outline-danger.remove-bhp-row.w-100(type="button" style="display: none; height: 38px;")
                      i.ti.ti-trash

            .d-flex.gap-2.mt-2
              button.btn.btn-success(type="submit")
                i.ti.ti-circle-check.me-1
                | Simpan Log & Selesaikan
              a.btn.btn-outline-secondary(href="/stafflab/inventories") Batal

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      const container = document.getElementById('bhp-rows-container');
      const addBtn = document.getElementById('add-bhp-row');
      const bhps = JSON.parse(container.getAttribute('data-bhps') || '[]');

      function updateRowState(row) {
        const select = row.querySelector('.bhp-select');
        const qtyInput = row.querySelector('.bhp-qty');
        const stockHelp = row.querySelector('.bhp-stock-help');

        if (!select || !qtyInput) return;
        const selectedOption = select.options[select.selectedIndex];
        const stock = selectedOption ? selectedOption.getAttribute('data-stock') : null;
        const unit = selectedOption ? selectedOption.getAttribute('data-unit') : null;

        if (stock !== null && select.value !== '') {
          stockHelp.textContent = `Stok tersedia: ${stock} ${unit}`;
          qtyInput.removeAttribute('disabled');
          qtyInput.setAttribute('required', 'required');
          qtyInput.setAttribute('max', stock);
        } else {
          stockHelp.textContent = '';
          qtyInput.setAttribute('disabled', 'disabled');
          qtyInput.removeAttribute('required');
          qtyInput.value = '';
        }
      }

      function attachEvents(row) {
        const select = row.querySelector('.bhp-select');
        select.addEventListener('change', () => updateRowState(row));

        const removeBtn = row.querySelector('.remove-bhp-row');
        removeBtn.addEventListener('click', () => {
          row.remove();
          updateRemoveButtons();
        });
      }

      function updateRemoveButtons() {
        const rows = container.querySelectorAll('.bhp-row');
        rows.forEach((row) => {
          const removeBtn = row.querySelector('.remove-bhp-row');
          if (rows.length > 1) {
            removeBtn.style.display = 'block';
          } else {
            removeBtn.style.display = 'none';
          }
        });
      }

      // Initial row setup
      const initialRows = container.querySelectorAll('.bhp-row');
      initialRows.forEach(row => {
        attachEvents(row);
        updateRowState(row);
      });
      updateRemoveButtons();

      if (addBtn) {
        addBtn.addEventListener('click', function () {
          const newRow = document.createElement('div');
          newRow.className = 'row bhp-row mb-3';
          
          let optionsHtml = '<option value="">-- Pilih BHP --</option>';
          bhps.forEach(bhp => {
            optionsHtml += `<option value="${bhp.id}" data-stock="${bhp.stock}" data-unit="${bhp.unit}">${bhp.name} (Tersedia: ${bhp.stock} ${bhp.unit})</option>`;
          });

          newRow.innerHTML = `
            <div class="col-md-5">
              <label class="form-label">Pilih BHP</label>
              <select class="form-select bhp-select" name="bhp_ids[]">
                ${optionsHtml}
              </select>
              <small class="bhp-stock-help text-primary fw-semibold mt-1 d-block"></small>
            </div>
            <div class="col-md-5">
              <label class="form-label">Jumlah BHP Digunakan</label>
              <input class="form-control bhp-qty" type="number" name="bhp_quantities[]" min="1" placeholder="Jumlah" disabled>
            </div>
            <div class="col-md-2">
              <label class="form-label d-none d-md-block">&nbsp;</label>
              <button class="btn btn-outline-danger remove-bhp-row w-100" type="button" style="height: 38px;">
                <i class="ti ti-trash"></i>
              </button>
            </div>
          `;

          container.appendChild(newRow);
          attachEvents(newRow);
          updateRemoveButtons();
        });
      }
    });
