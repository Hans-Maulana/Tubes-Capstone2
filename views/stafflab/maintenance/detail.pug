extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Detail Log Maintenance
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/stafflab/maintenance") Log Maintenance
                  li.breadcrumb-item.text-muted.active(aria-current="page") Detail
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  .row
    .col-lg-8
      .card
        .card-body
          h5.card-title.fw-semibold.mb-4 Riwayat Pemeliharaan

          if log.inventory
            .row.mb-4
              .col-md-6.mb-3
                p.text-muted.mb-1 Inventaris
                h6.fw-semibold.mb-0= log.inventory.name
                span.badge.bg-light-secondary.text-secondary= log.inventory.label_number
              .col-md-6.mb-3
                p.text-muted.mb-1 Ruangan (Saat Ini)
                h6.fw-semibold.mb-0= log.inventory.room ? log.inventory.room.name : '-'
              .col-md-6.mb-3
                p.text-muted.mb-1 Kategori
                h6.fw-semibold.mb-0= log.inventory.itemCategory ? log.inventory.itemCategory.name : (log.inventory.category || '-')
              .col-md-6.mb-3
                p.text-muted.mb-1 Kondisi Saat Ini
                if log.inventory.condition === 'Baik'
                  span.badge.bg-success Baik
                else if log.inventory.condition === 'Maintenance'
                  span.badge.bg-warning Maintenance
                else
                  span.badge.bg-danger Rusak

          hr
          .row
            .col-md-6.mb-3
              p.text-muted.mb-1 Tanggal Maintenance Selesai
              h6.fw-semibold.mb-0= log.date ? new Date(log.date).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) : '-'
            .col-md-6.mb-3
              p.text-muted.mb-1 Kondisi Setelah Maintenance
              if log.condition_after === 'Baik'
                span.badge.bg-success.rounded-3.fw-semibold Baik
              else if log.condition_after === 'Rusak'
                span.badge.bg-danger.rounded-3.fw-semibold Rusak
              else
                span.badge.bg-secondary.rounded-3.fw-semibold= log.condition_after || '-'
            .col-md-6.mb-3
              p.text-muted.mb-1 Petugas
              h6.fw-semibold.mb-0= log.staffLab ? log.staffLab.name : '-'
            .col-md-6.mb-3
              p.text-muted.mb-1 BHP Digunakan
              if log.bhpUsed
                h6.fw-semibold.mb-0= `${log.bhpUsed.name} — ${log.bhp_quantity_used} ${log.bhpUsed.unit}`
              else
                h6.fw-semibold.mb-0.text-muted Tidak menggunakan BHP

          .mb-0
            p.text-muted.mb-1 Deskripsi / Tindakan
            p.fw-normal.mb-0(style="white-space: pre-wrap;")= log.description || '-'

          .mt-4
            a.btn.btn-outline-secondary(href="/stafflab/maintenance")
              i.ti.ti-arrow-left.me-1
              | Kembali ke Log Maintenance
