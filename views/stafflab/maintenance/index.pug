extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Log Maintenance
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item.text-muted.active(aria-current="page") Log Maintenance
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if success
    .alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa.fa-check-circle.me-2
      strong Sukses!
      = success
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error!
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-12
      .card.w-100
        .card-body
          .d-flex.align-items-center.justify-content-between.mb-4.flex-wrap.gap-2
            div
              h5.card-title.fw-semibold.mb-0 Riwayat Maintenance Selesai
              p.card-subtitle.mb-0 Hanya menampilkan barang yang sudah selesai di-maintenance beserta detailnya.
            if user && user.role === 'Staf Laboratorium'
              a.btn.btn-outline-primary.d-flex.align-items-center.gap-2(href="/stafflab/inventories")
                i.ti.ti-packages.fs-5
                | Kelola Inventaris

          //- Form Filter Log Maintenance
          form.mb-4.pb-3.border-bottom(method="GET" action="/stafflab/maintenance")
            .row.g-3
              .col-md-3
                label.form-label.fw-semibold.fs-2.text-muted Nama Inventaris
                input.form-control(type="text" name="q" value=selectedQ placeholder="Cari nama barang...")
              .col-md-2
                label.form-label.fw-semibold.fs-2.text-muted No Label
                input.form-control(type="text" name="label" value=selectedLabel placeholder="LAB-INV-...")
              .col-md-2
                label.form-label.fw-semibold.fs-2.text-muted Ruangan
                select.form-select(name="room_id")
                  option(value="") — Semua Ruangan —
                  each room in rooms
                    option(value=room.id selected=(selectedRoomId == room.id))= room.name
              .col-md-2
                label.form-label.fw-semibold.fs-2.text-muted Petugas (Staf Lab)
                select.form-select(name="staff_id")
                  option(value="") — Semua Petugas —
                  each staff in staffs
                    option(value=staff.id selected=(selectedStaffId == staff.id))= staff.name
              .col-md-2
                label.form-label.fw-semibold.fs-2.text-muted Tanggal
                input.form-control(type="date" name="date" value=selectedDate)
              .col-md-1.d-flex.align-items-end.justify-content-end
                .d-flex.gap-1
                  button.btn.btn-primary.px-3(type="submit" title="Filter")
                    i.ti.ti-filter
                  a.btn.btn-outline-secondary.px-3(href="/stafflab/maintenance" title="Reset")
                    i.ti.ti-refresh

          .table-responsive

            table.table.align-middle.text-nowrap.mb-0
              thead.text-dark.fs-4
                tr
                  th.border-bottom-0.fw-semibold No
                  th.border-bottom-0.fw-semibold Tanggal Selesai
                  th.border-bottom-0.fw-semibold Inventaris
                  th.border-bottom-0.fw-semibold Kondisi Akhir
                  th.border-bottom-0.fw-semibold Ringkasan
                  th.border-bottom-0.fw-semibold Petugas
                  th.border-bottom-0.fw-semibold.text-center Detail
              tbody
                if logs && logs.length > 0
                  each log, index in logs
                    tr
                      td.border-bottom-0= index + 1
                      td.border-bottom-0
                        span.fw-normal= log.date ? new Date(log.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-'
                      td.border-bottom-0
                        if log.inventory
                          h6.fw-semibold.mb-1= log.inventory.name
                          span.badge.bg-light-secondary.text-secondary.fw-semibold= log.inventory.label_number
                        else
                          span.text-muted - (Terhapus)
                      td.border-bottom-0
                        if log.condition_after === 'Baik'
                          span.badge.bg-success.rounded-3.fw-semibold Baik
                        else if log.condition_after === 'Rusak'
                          span.badge.bg-danger.rounded-3.fw-semibold Rusak
                        else if log.condition_after
                          span.badge.bg-secondary.rounded-3.fw-semibold= log.condition_after
                        else
                          span.text-muted -
                      td.border-bottom-0
                        p.mb-0.fw-normal.text-wrap(style="max-width: 280px; font-size: 0.9rem;")
                          = log.description ? (log.description.length > 80 ? log.description.substring(0, 80) + '...' : log.description) : '-'
                        if log.logBhps && log.logBhps.length > 0
                          .d-flex.flex-wrap.gap-1.mt-1
                            each lb in log.logBhps
                              if lb.bhp
                                span.badge.bg-light-warning.text-warning= `${lb.bhp.name} (${lb.quantity} ${lb.bhp.unit})`
                        else if log.bhpUsed
                          span.badge.bg-light-warning.text-warning.mt-1= `${log.bhpUsed.name} (${log.bhp_quantity_used} ${log.bhpUsed.unit})`
                      td.border-bottom-0
                        span.fw-semibold= log.staffLab ? log.staffLab.name : '-'
                      td.border-bottom-0.text-center
                        a.btn.btn-sm.btn-outline-primary(href=`/stafflab/maintenance/${log.id}`)
                          i.ti.ti-eye.me-1
                          | Detail
                else
                  tr
                    td.text-center.py-4(colspan="7")
                      | Belum ada log maintenance.
                      br
                      small.text-muted Selesaikan maintenance dari menu Kelola Inventaris.
