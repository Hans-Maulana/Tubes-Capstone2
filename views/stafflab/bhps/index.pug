extends ../../layouts/master.pug

block content
  .row
    .col-12
      .card.bg-light-primary.shadow-none.position-relative.overflow-hidden.mb-4
        .card-body.px-4.py-3
          .row.align-items-center
            .col-9
              h4.fw-semibold.mb-8 Stok Bahan Habis Pakai (BHP)
              nav(aria-label="breadcrumb")
                ol.breadcrumb.mb-0
                  li.breadcrumb-item
                    a.text-muted.text-decoration-none(href="/dashboard") Dashboard
                  li.breadcrumb-item.text-muted.active(aria-current="page") Stok BHP
            .col-3
              .text-center.mb-n5
                img.img-fluid.mb-n4(src="/assets/images/backgrounds/welcome-bg.svg" alt="" style="max-height: 120px;")

  if success
    .alert.alert-success.alert-dismissible.fade.show(role="alert")
      i.fa.fa-check-circle.me-2
      strong Sukses!
      = success
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")
  if error
    .alert.alert-danger.alert-dismissible.fade.show(role="alert")
      i.fa.fa-exclamation-circle.me-2
      strong Error!
      = error
      button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Close")

  .row
    .col-12
      .card.w-100
        .card-body
          .d-flex.align-items-center.justify-content-between.mb-3.flex-wrap.gap-2
            div
              h5.card-title.fw-semibold.mb-0 Daftar Stok BHP
          .table-responsive
            table.table.table-hover.align-middle.mb-0
              thead.table-light
                tr
                  th.fw-semibold No
                  th.fw-semibold Nama BHP
                  th.fw-semibold Satuan
                  th.fw-semibold Stok Tersedia
              tbody
                if bhps && bhps.length > 0
                  each bhp, index in bhps
                    tr
                      td= index + 1
                      td.fw-semibold= bhp.name
                      td
                        span.badge.bg-light-secondary.text-secondary= bhp.unit
                      td
                        if bhp.stock < 5
                          span.badge.bg-light-danger.text-danger= `${bhp.stock} (Kritis)`
                        else if bhp.stock < 20
                          span.badge.bg-light-warning.text-warning= bhp.stock
                        else
                          span.badge.bg-light-success.text-success= bhp.stock
                else
                  tr
                    td.text-center.py-4.text-muted(colspan="4")
                      | Belum ada data BHP.
                      br
                      small Item BHP akan muncul setelah ada penerimaan barang dari pengadaan.
